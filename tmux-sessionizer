#!/usr/bin/env zsh

selected=$({
	printf '%s\n' opencode
	find "$HOME/personal/" "$HOME/lync" -mindepth 1 -maxdepth 1 -type d
} |
	fzf --layout=reverse --delimiter=/ --nth=-1 \
		--bind 'ctrl-p:up,ctrl-n:down,esc:abort,ctrl-c:abort' \
		--prompt='Project> ')

if [[ -z $selected ]]; then
	exit 0
fi

selected_name=$(basename "$selected" | tr . _)

# Prefix the shared session name so it sorts first in the session list.
if ! tmux has-session -t '=0-opencode' 2> /dev/null; then
	tmux new-session -ds 0-opencode -n opencode -c "$HOME/personal" opencode
fi

if [[ $selected == opencode ]]; then
	selected_name=0-opencode
elif ! tmux has-session -t "=$selected_name" 2> /dev/null; then
	tmux new-session -ds "$selected_name" -c "$selected"
	tmux new-window -t "=$selected_name" -c "$selected"
	tmux send-keys -t "=$selected_name:1" 'nvim .' Enter
	tmux select-window -t "=$selected_name:1"
fi

if [[ -z $TMUX ]]; then
	tmux attach-session -t "=$selected_name"
else
	tmux switch-client -t "=$selected_name"
fi
