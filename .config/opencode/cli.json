{
  "$schema": "https://opencode.ai/v2/cli.json",
  "keybinds": {
    "session.new": "ctrl+t,<leader>n",
    "variant.cycle": "none",
    "session.tab.close": "ctrl+w,<leader>w",
    "input.delete.word.backward": "ctrl+backspace,alt+backspace"
  },
  "theme": {
    "name": "catppuccin"
  },
  "diffs": {
    "wrap": "word"
  },
  "tabs": {
    "layout": "vertical"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "show"
  },
  "animations": true
}
