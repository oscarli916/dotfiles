{
  "$schema": "https://opencode.ai/v2/cli.json",
  "keybinds": {
    "session.new": "ctrl+t,<leader>n",
    "variant.cycle": "none",
    "session.tab.close": "ctrl+w,<leader>w",
    "input.delete.word.backward": "ctrl+backspace,alt+backspace",
    "session.half.page.up": "ctrl+u",
    "session.half.page.down": "ctrl+d",
    "input.delete.to.line.start": "none",
    "input.delete": "delete,shift+delete",
    "app.exit": "ctrl+c,<leader>q"
  },
  "theme": {
    "name": "catppuccin"
  },
  "diffs": {
    "wrap": "word"
  },
  "tabs": {
    "layout": "vertical"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "show"
  },
  "animations": true,
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.4
  }
}
