{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "opencode",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "opencode *",
      "effect": "deny"
    }
  ]
}
