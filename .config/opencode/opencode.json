{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "formatter": true,
  "lsp": true,
  "mcp": {
    "servers": {
      "dbhub": {
        "type": "local",
        "command": [
          "{env:HOME}/.local/bin/mise",
          "exec",
          "node@26",
          "--",
          "npx",
          "-y",
          "@bytebase/dbhub@latest",
          "--transport",
          "stdio",
          "--config",
          "{env:HOME}/.config/dbhub/dbhub.toml"
        ],
        "disabled": false
      },
      "playwright": {
        "type": "local",
        "command": [
          "{env:HOME}/.local/bin/mise",
          "exec",
          "node@22",
          "--",
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--browser",
          "chrome",
          "--headless",
          "--isolated"
        ]
      }
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "opencode",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "opencode *",
      "effect": "deny"
    },
    { "action": "shell", "resource": "opencode api get *", "effect": "allow" }
  ]
}
