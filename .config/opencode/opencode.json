{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "dbhub": {
        "type": "local",
        "command": [
          "{env:HOME}/.local/bin/mise",
          "exec",
          "node@26",
          "--",
          "npx",
          "-y",
          "@bytebase/dbhub@latest",
          "--transport",
          "stdio",
          "--config",
          "{env:HOME}/.config/dbhub/dbhub.toml"
        ],
        "disabled": false
      }
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "opencode",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "opencode *",
      "effect": "deny"
    }
  ]
}
